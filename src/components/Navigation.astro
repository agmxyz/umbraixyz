---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, translatePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Desktop Navigation -->
<div class="hidden md:flex items-center space-x-8">
  <a
    href={translatePath("/#risks", lang)}
    class="text-sm font-medium text-black hover:opacity-70 transition-opacity"
    >Privacy Risks</a
  >
  <a
    href={translatePath("/#solution", lang)}
    class="text-sm font-medium text-black hover:opacity-70 transition-opacity"
    >How It Works</a
  >
  <a
    href={translatePath("/#benefits", lang)}
    class="text-sm font-medium text-black hover:opacity-70 transition-opacity"
    >Benefits</a
  >
  <a
    href="/dashboard"
    class="text-sm font-medium text-black hover:opacity-70 transition-opacity"
    >{t('navigation.dashboard')}</a
  >
  <LanguageSwitcher />
  <a
    href="mailto:hello@umbrai.xyz?subject=Interest in Umbrai&body=Hi, I'm interested in learning more about Umbrai."
    class="bg-black text-gray-100 px-4 py-2 rounded-lg text-sm font-medium hover:opacity-90 transition-opacity"
  >
    {t('hero.cta')}
  </a>
</div>

<!-- Mobile Menu -->
<div
  class="mobile-menu hidden flex-col py-4 space-y-4 border-t border-black/10"
>
  <a
    href={translatePath("/#risks", lang)}
    class="text-base font-medium text-black py-3 hover:opacity-70 transition-opacity"
    >Privacy Risks</a
  >
  <a
    href={translatePath("/#solution", lang)}
    class="text-base font-medium text-black py-3 hover:opacity-70 transition-opacity"
    >How It Works</a
  >
  <a
    href={translatePath("/#benefits", lang)}
    class="text-base font-medium text-black py-3 hover:opacity-70 transition-opacity"
    >Benefits</a
  >
  <a
    href="/dashboard"
    class="text-base font-medium text-black py-3 hover:opacity-70 transition-opacity"
    >{t('navigation.dashboard')}</a
  >
  <div class="py-3">
    <LanguageSwitcher />
  </div>
  <a
    href="mailto:hello@umbrai.xyz?subject=Interest in Umbrai&body=Hi, I'm interested in learning more about Umbrai."
    class="bg-black text-gray-100 px-4 py-2 rounded-lg text-sm font-medium hover:opacity-90 transition-opacity inline-block"
  >
    {t('hero.cta')}
  </a>
</div>
